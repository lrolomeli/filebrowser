# Copia este archivo a .env y ajusta los valores.
# .env no se versiona; este ejemplo sí.

# Ruta absoluta de la carpeta del NAS. No uses "/" ni "/var".
FILES_HOST_PATH=/mnt/nas_netfiles

# true si FILES_HOST_PATH debe ser un punto de montaje NFS.
# Impide que el deploy use un directorio local vacío si el NAS no está montado.
FILES_REQUIRE_MOUNT=true

# Contraseña inicial del administrador. Usa una contraseña larga y aleatoria.
ADMIN_PASSWORD=change_me

# UID/GID del usuario que ejecuta el contenedor y es dueño de los archivos.
PUID=1000
PGID=1000
